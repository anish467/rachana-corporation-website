# PostgreSQL connection string (Supabase / Neon / Railway / managed Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Initial admin account. Create with npm run admin:create
ADMIN_EMAIL="admin@rachanacorporation.com"
ADMIN_PASSWORD="use-a-unique-password-minimum-12-characters"

# Resend email delivery: https://resend.com
RESEND_API_KEY="re_xxxxxxxxx"
CONTACT_TO_EMAIL="rachanacorporation@gmail.com"
# Must be a verified sender/domain in Resend. Example: website@rachanacorporation.com
CONTACT_FROM_EMAIL="website@your-verified-domain.com"

NEXT_PUBLIC_SITE_URL="https://rachanacorporation.com"
